{
    "name": "ianfoxdev/outbox",
    "description": "Transactional outbox for PHP: store events in the same database transaction, publish them to Kafka with a separate relay.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "outbox",
        "transactional-outbox",
        "kafka",
        "events",
        "event-driven",
        "postgresql",
        "doctrine",
        "laravel",
        "symfony"
    ],
    "homepage": "https://github.com/ianfoxdev/outbox",
    "authors": [
        {
            "name": "Anatoly Pankratyev",
            "email": "ianfoxdeveloper@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/IanFoxDev/outbox/issues",
        "source": "https://github.com/IanFoxDev/outbox"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4 || ^4.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "symfony/framework-bundle": "^7.4 || ^8.0"
    },
    "conflict": {
        "doctrine/dbal": "<3.8"
    },
    "suggest": {
        "ext-pdo_pgsql": "to record events through PDO or Doctrine DBAL with the pdo_pgsql driver",
        "doctrine/dbal": "to record events through a Doctrine DBAL connection (3.8 or later)",
        "illuminate/database": "to record events through a Laravel database connection",
        "symfony/http-kernel": "to use the Symfony bundle, with doctrine/doctrine-bundle (7.4 or later)"
    },
    "autoload": {
        "psr-4": {
            "IanFoxDev\\Outbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanFoxDev\\Outbox\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IanFoxDev\\Outbox\\Bridge\\Laravel\\OutboxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
