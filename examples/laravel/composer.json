{
    "name": "ianfoxdev/outbox-laravel-example",
    "description": "Laravel shop that records order events with ianfoxdev/outbox, plus a Kafka consumer.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-rdkafka": "*",
        "ianfoxdev/outbox": "*@dev",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
