    {
      "type": "state-timeline",
      "title": "Which replica leads",
      "description": "outbox_leader per replica. A change of colour is a failover.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (replica) (label_replace(outbox_leader, \"replica\", \"$1\", \"instance\", \"([^:]+):.*\"))",
          "legendFormat": "{{replica}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8E8E8E",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "standby"
                },
                "1": {
                  "text": "leader"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
