{
    "name": "ianfoxdev/outbox-symfony-example",
    "description": "Symfony shop that records order events with ianfoxdev/outbox, plus a Kafka consumer.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-rdkafka": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4 || ^4.0",
        "ianfoxdev/outbox": "*@dev",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "7.4.*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "DoctrineMigrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
